{
  "name": "ap-planner",
  "productName": "AP Planner",
  "version": "3.1.0",
  "description": "A&P — седмичен планер",
  "main": "main.js",
  "author": "A&P",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "app.ap.planner",
    "productName": "AP Planner",
    "files": ["main.js", "app/**/*"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "A&P", "createDesktopShortcut": true }
  }
}
